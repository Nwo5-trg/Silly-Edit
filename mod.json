{
    "geode": "6.0.0-alpha.1",
    "gd": {
        "win": "2.2091",
        "mac": "2.2091",
        "android": "2.2091"
    },
    "id": "nwo5.sillyedit",
    "name": "sillyedit",
    "version": "v0.2.0-beta.1",
    "developer": "Nwo5",
    "description": "betteredits adopted little sister est. 2.2081",
    "links": {
        "source": "https://github.com/Nwo5-trg/Silly-Edit",
        "community": "https://discord.gg/AeFeYWGUxZ"
    },
    "tags": ["editor", "bugfix", "customization", "enhancement", "interface", "utility", "offline"],
    "dependencies": {
        "geode.node-ids": ">=1.23.3",
        "nwo5.silly-api": ">=3.0.0",
        "alphalaneous.editortab_api": ">=v3.0.0",
        "alphalaneous.alphas-ui-pack": ">=v1.5.0"
    },
    "api": {
        "include": [
            "include/*.hpp"
        ]
    },
    "incompatibilities": {
        "hjfod.betteredit": {
            "version": ">=6.0.0",
            "breaking": false
        }
    },
    "resources": {
        "sprites": [
            "resources/*.png",
            "resources/object-tab-icons/*.png",
            "resources/logos/*.png",
            "resources/buttons/*.png"
        ],
        "spritesheets": {
            "Sheet": [
                "resources/sheet/*.png"
            ]
        },
        "files": [
            "resources/group-label-shenanigans/*.json"
        ]
    },
    "settings": {
        "General": {
            "type": "title",
            "name": "General"
        },
        "General-open-settings": {
            "type": "keybind",
            "name": "Open Settings",
            "category": "editor",
            "default": "Ctrl+Shift+P"
        },
        "Ruler": {
            "type": "title",
            "name": "Ruler"
        },
        "Ruler-Enabled": {
            "type": "bool",
            "name": "Enabled",
            "default": true
        },
        "Ruler-create-measurement-key": {
            "type": "keybind",
            "name": "Create Measurement",
            "category": "editor",
            "default": "Ctrl+M",
            "enable-if": "Ruler-Enabled"
        },
        "Ruler-delete-last-measurement-key": {
            "type": "keybind",
            "name": "Delete Last Measurement",
            "description": "hold to delete all",
            "category": "editor",
            "default": "Ctrl+Shift+M",
            "enable-if": "Ruler-Enabled"
        },
        "Selection Utils": {
            "type": "title",
            "name": "Selection Utils"
        },
        "Selection-Utils-Enabled": {
            "type": "bool",
            "name": "Enabled",
            "default": true
        },
        "Selection Utils-snap-selection": {
            "type": "keybind",
            "name": "Snap Selection",
            "category": "editor",
            "default": "L",
            "enable-if": "Selection-Utils-Enabled"
        },
        "Better Select All": {
            "type": "title",
            "name": "Better Select All"
        },
        "Better-Select-All-Enabled": {
            "type": "bool",
            "name": "Enabled",
            "default": true
        },
        "Better Select All-select-all-key": {
            "type": "keybind",
            "name": "Select All",
            "category": "editor",
            "default": "Ctrl+A",
            "enable-if": "Better-Select-All-Enabled"
        },
        "Better Select All-select-all-left-key": {
            "type": "keybind",
            "name": "Select All Left",
            "category": "editor",
            "default": "Ctrl+Left",
            "enable-if": "Better-Select-All-Enabled"
        },
        "Better Select All-select-all-down-key": {
            "type": "keybind",
            "name": "Select All Down",
            "category": "editor",
            "default": "Ctrl+Down",
            "enable-if": "Better-Select-All-Enabled"
        },
        "Better Select All-select-all-up-key": {
            "type": "keybind",
            "name": "Select All Up",
            "category": "editor",
            "default": "Ctrl+Up",
            "enable-if": "Better-Select-All-Enabled"
        },
        "Better Select All-select-all-right-key": {
            "type": "keybind",
            "name": "Select All Right",
            "category": "editor",
            "default": "Ctrl+Right",
            "enable-if": "Better-Select-All-Enabled"
        },
        "Flood Fill": {
            "type": "title",
            "name": "Flood Fill"
        },
        "Flood-Fill-Enabled": {
            "type": "bool",
            "name": "Enabled",
            "default": true
        },
        "Flood Fill-quick-fill": {
            "type": "keybind",
            "name": "Quick Fill",
            "category": "editor",
            "default": "K",
            "enable-if": "Flood-Fill-Enabled"
        },
        "Silly Keybinds": {
            "type": "title",
            "name": "Silly Keybinds"
        },
        "Silly-Keybinds-Enabled": {
            "type": "bool",
            "name": "Enabled",
            "default": true
        },
        "Silly Keybinds-make-object-invisible": {
            "type": "keybind",
            "name": "Make Object Invisible",
            "category": "editor",
            "default": "J",
            "enable-if": "Silly-Keybinds-Enabled"
        },
        "Silly Keybinds-restart-playtest": {
            "type": "keybind",
            "name": "Restart Playtest",
            "category": "editor",
            "default": "Ctrl+R",
            "enable-if": "Silly-Keybinds-Enabled"
        }
    }
}