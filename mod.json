{
    "geode": "5.9.0",
    "gd": {
        "win": "2.2081",
        "android": "2.2081",
        "mac": "2.2081",
        "ios": "2.2081"
    },
    "id": "nwo5.sillyedit",
    "name": "sillyedit",
    "version": "v0.1.0-beta.3",
    "developer": "Nwo5",
    "description": "betteredits adopted little sister est. 2.2081",
    "links": {
        "source": "https://github.com/Nwo5-trg/Silly-Edit",
        "community": "https://discord.gg/AeFeYWGUxZ"
    },
    "tags": ["editor", "bugfix", "customization", "enhancement", "interface", "utility", "offline"],
    "dependencies": {
        "geode.node-ids": ">=1.23.3",
        "nwo5.silly-api": ">=1.12.0",
        "hjfod.gmd-api": ">=1.5.0",
        "cvolton.level-id-api": ">=2.0.0",
        "alphalaneous.editortab_api": ">=v2.1.10",
        "alk.better-touch-prio": ">=1.0.20",
        "nwo5.ui-scaling": ">=v1.0.1",
        "alphalaneous.alphas-ui-pack": ">=v1.2.1",
        "blueblock6.cleanstartpos": {
            "version": ">=2.0.6",
            "required": false
        },
        "alphalaneous.tinker": {
            "version": ">=v1.0.17",
            "required": false
        }
    },
    "api": {
        "include": [
            "include/*.hpp"
        ]
    },
    "incompatibilities": {
        "hjfod.betteredit": {
            "version": "*",
            "breaking": false
        }
    },
    "resources": {
        "sprites": [
            "resources/*.png",
            "resources/object-tab-icons/*.png",
            "resources/logos/*.png",
            "resources/buttons/*.png"
        ],
        "spritesheets": {
            "Sheet": [
                "resources/sheet/*.png"
            ]
        },
        "files": [
            "resources/group-label-shenanigans/*.json"
        ]
    },
    "settings": {
        "General": {
            "type": "title",
            "name": "General"
        },
        "General-open-settings": {
            "type": "keybind",
            "name": "Open Settings",
            "category": "editor",
            "default": "Ctrl+Shift+P"
        },
        "Ruler": {
            "type": "title",
            "name": "Ruler"
        },
        "Ruler-Enabled": {
            "type": "bool",
            "name": "Enabled",
            "default": true
        },
        "Ruler-create-measurement-key": {
            "type": "keybind",
            "name": "Create Measurement",
            "category": "editor",
            "default": "Ctrl+M",
            "enable-if": "Ruler-Enabled"
        },
        "Ruler-delete-last-measurement-key": {
            "type": "keybind",
            "name": "Delete Last Measurement",
            "description": "hold to delete all",
            "category": "editor",
            "default": "Ctrl+Shift+M",
            "enable-if": "Ruler-Enabled"
        },
        "Flood Fill": {
            "type": "title",
            "name": "Flood Fill"
        },
        "Flood-Fill-Enabled": {
            "type": "bool",
            "name": "Enabled",
            "default": true
        },
        "Flood Fill-special-key": {
            "type": "keybind",
            "name": "Special",
            "category": "editor",
            "default": "K",
            "enable-if": "Flood-Fill-Enabled"
        },
        "Better Scale": {
            "type": "title",
            "name": "Better Scale"
        },
        "Better-Scale-Enabled": {
            "type": "bool",
            "name": "Enabled",
            "default": true
        },
        "Better Scale-activate-scale-control": {
            "type": "keybind",
            "name": "Activate Scale Control",
            "category": "editor",
            "default": "Z",
            "enable-if": "Better-Scale-Enabled"
        },
        "Better Scale-activate-scale-xy-control": {
            "type": "keybind",
            "name": "Activate Scale XY Control",
            "category": "editor",
            "default": "X",
            "enable-if": "Better-Scale-Enabled"
        },
        "Selection Utils": {
            "type": "title",
            "name": "Selection Utils"
        },
        "Selection-Utils-Enabled": {
            "type": "bool",
            "name": "Enabled",
            "default": true
        },
        "Selection Utils-snap-selection": {
            "type": "keybind",
            "name": "Snap Selection",
            "category": "editor",
            "default": "L",
            "enable-if": "Selection-Utils-Enabled"
        },
        "Zoom Input": {
            "type": "title",
            "name": "Zoom Input"
        },
        "Zoom-Input-Enabled": {
            "type": "bool",
            "name": "Enabled",
            "default": true
        },
        "Zoom Input-zoom-in": {
            "type": "keybind",
            "name": "Zoom In",
            "category": "editor",
            "default": "Ctrl+=",
            "enable-if": "Zoom-Input-Enabled"
        },
        "Zoom Input-zoom-out": {
            "type": "keybind",
            "name": "Zoom Out",
            "category": "editor",
            "default": "Ctrl+Subtract",
            "enable-if": "Zoom-Input-Enabled"
        },
        "Better Select All": {
            "type": "title",
            "name": "Better Select All"
        },
        "Better-Select-All-Enabled": {
            "type": "bool",
            "name": "Enabled",
            "default": true
        },
        "Better Select All-select-all-key": {
            "type": "keybind",
            "name": "Select All",
            "category": "editor",
            "default": "Ctrl+A",
            "enable-if": "Better-Select-All-Enabled"
        },
        "Better Select All-select-all-left-key": {
            "type": "keybind",
            "name": "Select All Left",
            "category": "editor",
            "default": "Ctrl+Left",
            "enable-if": "Better-Select-All-Enabled"
        },
        "Better Select All-select-all-down-key": {
            "type": "keybind",
            "name": "Select All Down",
            "category": "editor",
            "default": "Ctrl+Down",
            "enable-if": "Better-Select-All-Enabled"
        },
        "Better Select All-select-all-up-key": {
            "type": "keybind",
            "name": "Select All Up",
            "category": "editor",
            "default": "Ctrl+Up",
            "enable-if": "Better-Select-All-Enabled"
        },
        "Better Select All-select-all-right-key": {
            "type": "keybind",
            "name": "Select All Right",
            "category": "editor",
            "default": "Ctrl+Right",
            "enable-if": "Better-Select-All-Enabled"
        },
        "Silly Keybinds": {
            "type": "title",
            "name": "Silly Keybinds"
        },
        "Silly-Keybinds-Enabled": {
            "type": "bool",
            "name": "Enabled",
            "default": true
        },
        "Silly Keybinds-toggle-ignore-damage": {
            "type": "keybind",
            "name": "Toggle Ignore Damage",
            "category": "editor",
            "default": "N",
            "enable-if": "Silly-Keybinds-Enabled"
        },
        "Silly Keybinds-make-object-invisible": {
            "type": "keybind",
            "name": "Make Object Invisible",
            "category": "editor",
            "default": "K",
            "enable-if": "Silly-Keybinds-Enabled"
        },
        "Scroll Groups": {
            "type": "title",
            "name": "Scroll Groups"
        },
        "Scroll-Groups-Enabled": {
            "type": "bool",
            "name": "Enabled",
            "default": true
        },
        "Scroll Groups-modifier": {
            "type": "keybind",
            "name": "Modifier",
            "category": "editor",
            "default": "Shift+LeftShift",
            "enable-if": "Scroll-Groups-Enabled"
        }
    }
}